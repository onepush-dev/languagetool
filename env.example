# LanguageTool 6.8 on Railway: every variable with its TEMPLATE value.
# Nothing needs to be filled in at deploy time. There are no secrets: LanguageTool's open-source
# HTTP API has no authentication (see README, "Who can use it").

### LanguageTool (public, domain -> port 8010, health /v2/languages, no volume, start command in railway/start-command.txt)
PORT=8010
RAILWAY_RUN_UID=0
Java_Xms=256m
Java_Xmx=1g
NGRAM_LANGUAGES=none
langtool_trustXForwardForHeader=true
langtool_requestLimit=120
langtool_requestLimitPeriodInSeconds=60
langtool_maxTextLength=100000
langtool_maxCheckTimeMillis=60000
langtool_cacheSize=1000
langtool_pipelineCaching=true

# --- Optional, add after deploy (not in the template) ---
# NGRAM_LANGUAGES=en                       # n-gram data (en,de,es,fr,nl). Needs a volume at /ngrams; see README
# langtool_languageModel=/ngrams           # set automatically when n-gram data is on the volume
# langtool_pipelinePrewarming=true         # build checking pipelines at boot (slower start, faster first check)
# langtool_maxPipelinePoolSize=5           # cached pipelines per language (default 5)
# langtool_maxCheckThreads=10              # parallel checks (default 10)
# langtool_maxWorkQueueSize=50             # reject requests when this many are queued (default 0 = unlimited)
# langtool_disabledRuleIds=WHITESPACE_RULE # rules to switch off server-wide (comma separated)
# langtool_requestLimitInBytes=1000000     # per-IP byte limit per period (default 0 = off)
# langtool_timeoutRequestLimit=10          # per-IP limit on checks that hit the time limit (default 0 = off)
